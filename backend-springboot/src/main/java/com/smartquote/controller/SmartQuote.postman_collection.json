        {
          "name": "Get Contact by ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/contacts/{{contactId}}"
          }
        },
        {
          "name": "Create Contact",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contactPerson\": \"Raj Kumar\",\n  \"companyName\": \"Beta Industries\",\n  \"email\": \"raj@beta.com\",\n  \"phone\": \"9123456789\",\n  \"gstType\": \"regular\",\n  \"gstin\": \"27AABCU9603R1ZM\",\n  \"address\": \"12 MG Road\",\n  \"city\": \"Mumbai\",\n  \"state\": \"Maharashtra\",\n  \"country\": \"India\",\n  \"pincode\": \"400001\",\n  \"status\": \"active\"\n}"
            },
            "url": "{{baseUrl}}/api/contacts",
            "description": "businessId is set from your session. gstType: regular | composition | unregistered."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  if (j.id) pm.collectionVariables.set('contactId', j.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Update Contact",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"contactPerson\": \"Raj Kumar Updated\",\n  \"phone\": \"9123456790\",\n  \"city\": \"Pune\",\n  \"state\": \"Maharashtra\"\n}"
            },
            "url": "{{baseUrl}}/api/contacts/{{contactId}}",
            "description": "Partial update — only non-null fields are applied."
          }
        },
        {
          "name": "Delete Contact (soft)",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/contacts/{{contactId}}",
            "description": "Soft delete — sets status to deleted. Returns 204."
          }
        }
      ]
    },
