{
  "info": {
    "_postman_id": "smartquote-api-collection",
    "name": "SmartQuote API",
    "description": "Complete Postman collection for all SmartQuote backend controllers.\n\n**Setup**\n1. Start the Spring Boot app (default port 8080).\n2. Set `MONGODB_URI` in your environment.\n3. Import this collection into Postman.\n4. Run **Auth → 1. Sign Up** (or Sign In flow) first — token and IDs are saved automatically.\n\n**Auth header (protected routes)**\n`Authorization: Bearer {{token}}`\n\n**Dev OTP helper**\nAfter Sign In or Forgot Password, call `GET /api/auth/dev/otp?key=<email>` (sign-in) or `key=reset:<email>` (password reset).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" },
    { "key": "businessId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "email", "value": "owner@acme.com" },
    { "key": "password", "value": "password123" },
    { "key": "contactId", "value": "" },
    { "key": "inventoryId", "value": "" },
    { "key": "templateId", "value": "" },
    { "key": "quotationId", "value": "" },
    { "key": "otp", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "description": "AuthController — `/api/auth`. Most routes are public. `/me` and `/sign-out` need the Bearer token.",
      "item": [
        {
          "name": "1. Sign Up",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"businessName\": \"Acme Traders\",\n  \"ownerName\": \"John Doe\",\n  \"email\": \"{{email}}\",\n  \"phone\": \"9876543210\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/sign-up",
            "description": "Creates business + admin user. Returns session token immediately (no OTP on sign-up).\n\n**Required body fields:** businessName, ownerName, email, phone, password (min 8 chars)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  if (j.token) pm.collectionVariables.set('token', j.token);",
                  "  if (j.businessId) pm.collectionVariables.set('businessId', j.businessId);",
                  "  if (j.userId) pm.collectionVariables.set('userId', j.userId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2. Sign In (send OTP)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/sign-in",
            "description": "Step 1 of sign-in. Validates credentials and sends OTP.\n\nNext: call **Dev Get OTP** with `key={{email}}`, then **Verify OTP**."
          }
        },
        {
          "name": "3. Dev Get OTP (sign-in)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/dev/otp?key={{email}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "dev", "otp"],
              "query": [{ "key": "key", "value": "{{email}}", "description": "Email used in sign-in" }]
            },
            "description": "Dev-only. Returns OTP without consuming it. OTP key = email address."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.otp) pm.collectionVariables.set('otp', j.otp);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4. Verify OTP",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/verify-otp",
            "description": "Step 2 of sign-in. Returns session token on success."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.token) pm.collectionVariables.set('token', j.token);",
                  "  if (j.businessId) pm.collectionVariables.set('businessId', j.businessId);",
                  "  if (j.userId) pm.collectionVariables.set('userId', j.userId);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Get Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/me",
            "description": "Returns current user profile. Token required; response token field is null."
          }
        },
        {
          "name": "Sign Out",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/auth/sign-out",
            "description": "Invalidates session token. Returns 204 No Content."
          }
        },
        {
          "name": "Forgot Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/forgot-password",
            "description": "Sends OTP for password reset if email exists."
          }
        },
        {
          "name": "Dev Get OTP (password reset)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/auth/dev/otp?key=reset:{{email}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "dev", "otp"],
              "query": [{ "key": "key", "value": "reset:{{email}}" }]
            },
            "description": "Dev-only. OTP key for password reset is `reset:<email>`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  if (j.otp) pm.collectionVariables.set('otp', j.otp);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Reset Password",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"otp\": \"{{otp}}\",\n  \"newPassword\": \"newpassword123\"\n}"
            },
            "url": "{{baseUrl}}/api/auth/reset-password",
            "description": "Resets password after OTP verification. newPassword min 8 chars."
          }
        }
      ]
    },
    {
      "name": "Contacts",
      "description": "ContactController — `/api/contacts`. Alias: CustomerController at `/api/customers` (same behaviour).",
      "item": [
        {
          "name": "List Contacts",
